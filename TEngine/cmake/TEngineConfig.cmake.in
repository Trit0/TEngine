@PACKAGE_INIT@

# Include Conan toolchain to make dependencies available
include("@CONAN_OUTPUT_FOLDER@/conan_toolchain.cmake")

# Find all the dependencies that TEngine needs
find_package(glm REQUIRED)
find_package(glfw3 REQUIRED)
find_package(Vulkan REQUIRED)
find_package(tinyobjloader REQUIRED)
find_package(simdjson REQUIRED)
find_package(stb REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/TEngineTargets.cmake")

check_required_components(TEngine)